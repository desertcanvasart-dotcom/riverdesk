# vessel-system configuration.
# Local development and tests: `cp .env.example .env` — the defaults below match the local
# Supabase stack (`pnpm supabase:start`) and are not secrets.
# Hosted: keep real values in `.env.hosted` (never committed) and run with VS_ENV_FILE=.env.hosted.

# local | ci | hosted. Destructive scripts (reset, seed) and the test suite refuse non-local databases.
VS_ENV=local
# pino level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Database -----------------------------------------------------------------
# Admin connection (the `postgres` user). Used only by migrations, bootstrap and seed.
# Hosted: the Session pooler string from the dashboard's Connect panel.
DATABASE_URL_ADMIN=postgresql://postgres:postgres@127.0.0.1:55322/postgres
# Host and port the runtime roles connect to. Hosted: the Transaction pooler host, port 6543.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=55322
# Session-mode port for the worker (LISTEN/NOTIFY). Hosted: 5432 on the pooler host.
# Defaults to DATABASE_PORT.
DATABASE_SESSION_PORT=
DATABASE_NAME=postgres
# true on hosted Supabase
DATABASE_SSL=false
# Connections per process pool.
DATABASE_POOL_MAX=10
# Hosted only: pooler user names are `<role>.<project ref>`.
SUPABASE_PROJECT_REF=

# Passwords for the runtime roles (rule 7: not owners, no BYPASSRLS). Migrations set them.
# Hosted: generate with `openssl rand -hex 24`.
VS_BACKOFFICE_PASSWORD=local-backoffice-pw
VS_API_PASSWORD=local-api-pw
VS_WORKER_PASSWORD=local-worker-pw

# --- Supabase Auth (back office staff login) ------------------------------------
SUPABASE_URL=http://127.0.0.1:55321
# Local stack's public publishable key (printed by `supabase status`).
SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# Never add the service_role key to this file or any app (rule 7).

# --- Personal data ---------------------------------------------------------------
# AES-256-GCM key for passport numbers (Batch 3): 32 bytes, base64. The id is stored with each
# ciphertext so keys can rotate. Local value below is a dummy; hosted: `openssl rand -base64 32`.
PASSPORT_KEY_ID=local1
PASSPORT_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# --- Seed (local only) -----------------------------------------------------------
# Password for the seeded demo staff logins.
SEED_STAFF_PASSWORD=demo-password-123

# --- Channel API -------------------------------------------------------------------
# Signs access tokens (15 minutes). Local value is a dummy; hosted: `openssl rand -base64 32`.
API_TOKEN_SECRET=bG9jYWwtb25seS10b2tlbi1zZWNyZXQtbm90LWZvci1wcm9kdWN0aW9uIQ==
