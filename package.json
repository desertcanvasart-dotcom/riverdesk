{
  "name": "vessel-system",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint && prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "format": "prettier --write .",
    "supabase:start": "supabase start -x studio,imgproxy,realtime,storage-api,edge-runtime,logflare,vector,postgres-meta,supavisor,mailpit",
    "supabase:stop": "supabase stop",
    "db:migrate": "pnpm --filter @vs/db migrate",
    "db:seed": "pnpm --filter @vs/db seed && pnpm --filter @vs/engine seed-demo",
    "db:codegen": "pnpm --filter @vs/db codegen",
    "db:reset": "pnpm --filter @vs/db reset && pnpm --filter @vs/engine seed-demo",
    "db:check-roles": "pnpm --filter @vs/db check-roles",
    "platform:create-company": "pnpm --filter @vs/db create-company",
    "sandbox:setup": "pnpm --filter @vs/engine sandbox-setup"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.18.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
